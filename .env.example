# Database
DB_URL=jdbc:mysql://localhost:3306/elibrary?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=elibrary
DB_PASSWORD=elibrary
DB_POOL_SIZE=40

# Application role and local identity
APP_ROLE=all
DEV_AUTH_ENABLED=true
DEV_USER_ID=10001
DEV_USER_ROLE=USER

# Lending policy
MAX_ACTIVE_LOANS=5
LOAN_DAYS=14
LOAN_POLICY_VERSION=v1

# Optional RocketMQ publisher
ROCKETMQ_ENABLED=false
ROCKETMQ_ENDPOINTS=localhost:8081

# Outbox 提交后直发
OUTBOX_DIRECT_THREADS=2
OUTBOX_DIRECT_QUEUE_CAPACITY=500

# XXL-JOB 补偿执行器（需另行部署调度中心）
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://localhost:8088/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=
XXL_JOB_ADMIN_TIMEOUT_SECONDS=3
XXL_JOB_EXECUTOR_APP_NAME=e-library-outbox
XXL_JOB_EXECUTOR_ADDRESS=
XXL_JOB_EXECUTOR_IP=
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_LOG_PATH=./logs/xxl-job
XXL_JOB_LOG_RETENTION_DAYS=30
